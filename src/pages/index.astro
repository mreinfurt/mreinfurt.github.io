---
import PageLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Label from "../components/Label.astro";
import SkillLayout from "../components/SkillLayout.astro";

import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpeg";

const cloud = ["Azure Cloud"];
const architecture = ["Monolith, Serverless, Event-based"];
const backend = [".NET/C#"];
const frontend = ["Angular (TypeScript)"];
const cicd = ["Azure DevOps", "GitHub", "GitLab"];
const devops = ["Azure Bicep", "Terraform", "Docker", "Kubernetes"];
const security = ["ISO 27001", "DevSecOps"];
---

<PageLayout meta={{ title: "Home" }}>
  <div class="flex w-full flex-col gap-y-10">
    <section class="flex flex-col items-center gap-y-7">
      <Image
        src={profileImage}
        alt="profile photo"
        class="h-28 w-auto rounded-full bg-[#555555] p-1"
        loading="eager"
      />

      <div class="flex flex-col items-center gap-y-4">
        <h1 class="text-^3xl font-bold">Manuel Reinfurt</h1>
        <span class="text-2xl">Freelance Azure Cloud Architect & Developer</span>
        <div class="flex flex-wrap justify-center gap-x-7 gap-y-3">
          <Label title="Düsseldorf">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-5 w-5"
              slot="icon"
              ><path
                fill="currentColor"
                d="M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904"
              ></path></svg
            >
          </Label>
          <Label
            title="LinkedIn"
            as="a"
            href="http://linkedin.com/in/manuel-reinfurt-1868a1153/"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              slot="icon"
              class="h-5 w-5 text-foreground/75"
              ><path
                fill="currentColor"
                d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
              ></path></svg
            >
          </Label>
          <Label
            title="GitHub"
            as="a"
            href="http://github.com/mreinfurt"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              slot="icon"
              class="h-5 w-5 text-foreground/75"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              ></path></svg
            >
          </Label>
        </div>
      </div>
    </section>

    <Section title="About Me">
      <p class="text-muted-foreground">
        Experienced Cloud Architect and Software Developer with over 10 years of expertise. Specialized in Azure Cloud, software development (.NET/C#, Angular), IaC (Terraform, Bicep) and DevOps best practices. I’m passionate about efficient, secure, and innovative software solutions.
      </p>
      <p class="text-muted-foreground">I'm available for architecture, DevSecOps and development projects, preferably  in agile teams. I have experience working in internationals teams and with clients like Vileda, Ströer, Röhlig Logistics, Trilux, Stihl.</p>
    </Section>

    <Section title="Work Highlights">
		<a href="https://www.linkedin.com/in/manuel-reinfurt-1868a1153/">View full work experience on LinkedIn</a>
		<Card
			heading="Cloud Architect & Developer"
			subheading="Startup Company | IT"
			date="2023-2025"
		>
		</Card>
		<Card
			heading="Department Lead | New Business Solutions"
			subheading="q.beyond AG | IT Service Provider"
			date="2020-2022"
		>
		</Card>
		<Card
			heading="Domain Architect | Business Banking"
			subheading="ING Frankfurt | Finance"
			date="2020">
		</Card>
    </Section>

    <Section title="Certifications">
      <Card
        heading="Microsoft Certified: Azure Solutions Architect Expert"
        imagePath="/src/assets/microsoft-certified-expert-badge.png"
        altText="Microsoft Certified Expert Badge"
        imageClass="h-12 w-auto md:-left-16"
        date="2025"
      >
        <a
          href="https://learn.microsoft.com/api/credentials/share/de-de/ManuelReinfurt-0160/340B3B0B80E57B75?sharingId=F62B9C4623335750"
          >View on Microsoft Learn</a
        >
      </Card>
      <Card
        heading="Microsoft Certified: DevOps Engineer Expert"
        imagePath="/src/assets/microsoft-certified-expert-badge.png"
        altText="Microsoft Certified Expert Badge"
        imageClass="h-12 w-auto md:-left-16"
        date="2024"
      >
        <a
          href="https://learn.microsoft.com/api/credentials/share/en-us/ManuelReinfurt-0160/227FB3B230C3E89A?sharingId=F62B9C4623335750"
          >View on Microsoft Learn</a
        >
      </Card>
      <Card
        heading="Microsoft Certified: Azure Developer Associate"
        imagePath="/src/assets/microsoft-certified-associate-badge.png"
        date="2024"
        altText="Microsoft Certified Associate Badge"
        imageClass="h-12 w-auto md:-left-16"
      >
        <a
          href="https://learn.microsoft.com/api/credentials/share/de-de/ManuelReinfurt-0160/274212D6298AD695?sharingId=F62B9C4623335750"
          >View on Microsoft Learn</a
        >
      </Card>
      <Card
        heading="Microsoft Certified: Azure Administrator Associate"
        imagePath="/src/assets/microsoft-certified-associate-badge.png"
        date="2025"
        altText="Microsoft Certified Associate Badge"
        imageClass="h-12 w-auto md:-left-16"
      >
        <a
          href="https://learn.microsoft.com/api/credentials/share/de-de/ManuelReinfurt-0160/4897A33075EA8900?sharingId=F62B9C4623335750"
          >View on Microsoft Learn</a
        >
      </Card>
    </Section>

    <Section title="Technical Focus">
      <SkillLayout title="Cloud" skills={cloud} />
      <SkillLayout title="Architecture" skills={architecture} />
      <SkillLayout title="Backend" skills={backend} />
      <SkillLayout title="Frontend" skills={frontend} />
      <SkillLayout title="CI & CD" skills={cicd} />
      <SkillLayout title="DevOps & IaC" skills={devops} />
      <SkillLayout title="Security & Compliance" skills={security} />
    </Section>

    <Section title="Education">
      <Card
        heading="Master of Science - Computer Science"
        subheading="Darmstadt University of Applied Sciences"
        date="2014-2018"
      />
      <Card
        heading="Bachelor of Science - Computer Science"
        subheading="Darmstadt University of Applied Sciences"
        date="2011-2014"
      />
    </Section>
  </div>
</PageLayout>
